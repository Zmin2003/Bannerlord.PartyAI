                                <ButtonWidget DataSource="{CopyPasteToggle}" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!PartyRow.Icon" SuggestedHeight="!PartyRow.Icon" MarginRight="6" VerticalAlignment="Center" Brush="SPOptions.Checkbox.Empty.Button" ButtonType="Toggle" IsDisabled="@IsDisabled" IsSelected="@IsSelected" ToggleIndicator="ToggleIndicator" UpdateChildrenStates="true"><Children><ImageWidget Id="ToggleIndicator" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" /></Children></ButtonWidget>

