              <Children>
                <ButtonWidget DataSource="{SelectAllToggle}" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32" VerticalAlignment="Center" Brush="SPOptions.Checkbox.Empty.Button" ButtonType="Toggle" IsDisabled="@IsDisabled" IsSelected="@IsSelected" ToggleIndicator="ToggleIndicator" UpdateChildrenStates="true"><Children><ImageWidget Id="ToggleIndicator" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" /></Children></ButtonWidget>
