                                  </Children>
                                </ListPanel>

                                <ScrollingRichTextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="80" Brush="PartyAI.Menu.PartyRowText" Text="@PartySize" IsAutoScrolling="false" ScrollOnHoverWidget=".." Command.HoverBegin="PartySizeBeginHint" Command.HoverEnd="PartySizeEndHint" />
