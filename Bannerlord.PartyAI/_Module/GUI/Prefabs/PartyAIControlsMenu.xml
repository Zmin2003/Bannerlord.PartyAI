                                <ScrollingRichTextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="145" Brush="PartyAI.Menu.PartyRowText" Text="@TemplateName" IsAutoScrolling="false" ScrollOnHoverWidget=".." />
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30" MarginLeft="2" MarginRight="2" VerticalAlignment="Center" IsEnabled="@AllowEditTemplate" UpdateChildrenStates="true" Command.Click="EditPartyTemplate"><Children><BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="PartyAI.Menu.EditButton" /><HintWidget DataSource="{ChangeTemplateHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" /></Children></ButtonWidget>

                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="6"><Children><Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" Sprite="BlankWhiteSquare_9" Color="#E2664FFF" IsVisible="@StatusNeedsAttention" IsEnabled="false" /><ScrollingRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="9" Brush="PartyAI.Menu.StatusText" Text="@ActiveOrder" IsAutoScrolling="false" ScrollOnHoverWidget=".." /><HintWidget DataSource="{StatusHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" /></Children></Widget>
