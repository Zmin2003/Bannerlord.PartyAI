                <PartyAIDropdown Parameter.DataSource="{SortController}" WidthSizePolicy="Fixed" SuggestedWidth="200" VerticalAlignment="Center" />
                <PartyAIDropdown Parameter.DataSource="{SortDirectionController}" WidthSizePolicy="Fixed" SuggestedWidth="58" MarginLeft="8" VerticalAlignment="Center" />
              </Children>
