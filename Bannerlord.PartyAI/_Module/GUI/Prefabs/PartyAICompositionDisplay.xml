<Prefab>
  <Constants>
    <Constant Name="Icon.Width" Value="26" />
    <Constant Name="Icon.Height" Value="34" />
    <Constant Name="Text.Width" Value="48" />
  </Constants>
  <Parameters>
    <Parameter Name="DataSource" DefaultValue="" />
  </Parameters>
  <Window>
    <ListPanel DataSource="*DataSource" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="!Icon.Height" StackLayout.LayoutMethod="HorizontalLeftToRight">
      <Children>
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Icon.Width" SuggestedHeight="!Icon.Height" Sprite="General\TroopTypeIcons\icon_troop_type_infantry" Color="#BE945BFF" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="!Text.Width" Brush="PartyAI.Menu.PartyRowText" Text="@InfantryCount" />
            <HintWidget DataSource="{InfantryHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </ListPanel>
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Icon.Width" SuggestedHeight="!Icon.Height" Sprite="General\TroopTypeIcons\icon_troop_type_bow" Color="#BE945BFF" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="!Text.Width" Brush="PartyAI.Menu.PartyRowText" Text="@RangedCount" />
            <HintWidget DataSource="{RangedHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </ListPanel>
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Icon.Width" SuggestedHeight="!Icon.Height" Sprite="General\TroopTypeIcons\icon_troop_type_cavalry" Color="#BE945BFF" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="!Text.Width" Brush="PartyAI.Menu.PartyRowText" Text="@CavalryCount" />
            <HintWidget DataSource="{CavalryHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </ListPanel>
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Icon.Width" SuggestedHeight="!Icon.Height" Sprite="General\TroopTypeIcons\icon_troop_type_horse_archer" Color="#BE945BFF" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="!Text.Width" Brush="PartyAI.Menu.PartyRowText" Text="@HorseArcherCount" />
            <HintWidget DataSource="{HorseArcherHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </ListPanel>
      </Children>
    </ListPanel>
  </Window>
</Prefab>
