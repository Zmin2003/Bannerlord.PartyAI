<Prefab>
  <Parameters>
    <Parameter Name="DataSource" DefaultValue="" />
  </Parameters>
  <Window>
    <Widget DataSource="*DataSource" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsVisible">
      <Children>

        <!-- Toolbar -->
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Top" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="200" UpdateChildrenStates="true">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="ButtonBrush2" IsEnabled="@CanCreateParty" UpdateChildrenStates="true" Command.Click="ExecuteCreateParty">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Kingdom.GeneralButtons.Text" Text="@CreatePartyText" />
                  </Children>
                </ButtonWidget>
                <HintWidget DataSource="{CreatePartyHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
              </Children>
            </Widget>
            <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="200" MarginLeft="16" StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32" VerticalAlignment="Center" Brush="SPOptions.Checkbox.Empty.Button" ButtonType="Toggle" IsSelected="@ShowAllHeroes" ToggleIndicator="ToggleIndicator" UpdateChildrenStates="true">
                  <Children>
                    <ImageWidget Id="ToggleIndicator" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
                  </Children>
                </ButtonWidget>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="6" Brush="PartyAI.Menu.SecondaryText" Text="@ShowAllHeroesText" />
                <HintWidget DataSource="{ShowAllHeroesHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
              </Children>
            </ListPanel>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="50" Brush="PartyAI.Menu.SecondaryText" Text="@SortText" />
            <Standard.DropdownWithHorizontalControl VerticalAlignment="Center" Parameter.SelectorDataSource="{SortSelector}" Parameter.ShowNextAndPrevious="false" Parameter.IsCustomWidth="true" Parameter.CustomWidth="170" />
          </Children>
        </ListPanel>

        <!-- Master / detail -->
        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="50" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <PartyAiEntryList WidthSizePolicy="Fixed" SuggestedWidth="700" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="14" IsVisible="@HasSelection">
              <Children>
                <PartyAiDetail Parameter.DataSource="{Detail}" />
              </Children>
            </Widget>
          </Children>
        </ListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>
