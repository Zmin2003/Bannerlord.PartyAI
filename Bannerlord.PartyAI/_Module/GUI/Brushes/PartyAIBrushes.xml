<Brushes>
  <Brush Name="PartyAI.Menu.PartyRowText" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F4E1C4FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" TextShadowAngle="60" FontSize="25" />
      <Style Name="Disabled" FontColor="#8C8277FF" TextOutlineAmount="0" FontSize="25" />
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.SectionHeader" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#FEC157FF" TextOutlineAmount="0" TextGlowRadius="0" FontSize="27" />
      <Style Name="Disabled" FontColor="#8C7657FF" TextOutlineAmount="0" FontSize="27" />
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.SecondaryText" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#C9BBA8FF" TextOutlineAmount="0" FontSize="21" />
      <Style Name="Disabled" FontColor="#776F66FF" TextOutlineAmount="0" FontSize="21" />
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.TableHeaderText" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#B9A78FFF" TextOutlineAmount="0" FontSize="20" />
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.StatusText" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E9D6B7FF" TextOutlineAmount="0" FontSize="22" />
      <Style Name="Disabled" FontColor="#82786CFF" TextOutlineAmount="0" FontSize="22" />
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.WarningText" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#FF9B83FF" TextOutlineAmount="0" FontSize="22" />
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.Row.Background">
    <Layers>
      <BrushLayer Name="Background" Sprite="BlankWhiteSquare_9" Color="#17130FCC" />
    </Layers>
  </Brush>

  <Brush Name="PartyAI.Menu.Row.Selected">
    <Layers>
      <BrushLayer Name="Background" Sprite="BlankWhiteSquare_9" Color="#78592799" />
    </Layers>
  </Brush>

  <Brush Name="PartyAI.Menu.Summary.Background">
    <Layers>
      <BrushLayer Name="Background" Sprite="BlankWhiteSquare_9" Color="#1E1914E6" />
    </Layers>
  </Brush>

  <Brush Name="PartyAI.Menu.EditButton">
    <Layers>
      <BrushLayer Name="Default" Sprite="Clan\edit_name_icon" Color="#BE945BFF" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" IsHidden="false" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" IsHidden="false" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" IsHidden="false" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" IsHidden="false" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="PartyAI.Menu.UpArrow">
    <Layers>
      <BrushLayer Name="Default" Sprite="PartyScreen\upgrade_icon" IsHidden="true" />
      <BrushLayer Name="Disabled" Sprite="PartyScreen\upgrade_icon" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" IsHidden="false" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.5" IsHidden="false" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1" IsHidden="false" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Disabled" IsHidden="false" />
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="PartyAI.Menu.DownArrow">
    <Layers>
      <BrushLayer Name="Default" Sprite="PartyScreen\upgrade_icon" VerticalFlip="true" IsHidden="true" />
      <BrushLayer Name="Disabled" Sprite="PartyScreen\upgrade_icon" VerticalFlip="true" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" IsHidden="false" VerticalFlip="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.5" IsHidden="false" VerticalFlip="true" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1" IsHidden="false" VerticalFlip="true" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Disabled" IsHidden="false" VerticalFlip="true" />
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>
  
  <Brush Name="PartyAI.Menu.CopyButton" TransitionDuration="0.2">
    <Layers>
      <BrushLayer Name="Default" Sprite="MPLobby\Generic\copy_icon" Color="#FEC157FF"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" Sprite="MPLobby\Generic\copy_icon" ColorFactor="1"/>
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" Sprite="MPLobby\Generic\copy_icon" ColorFactor="1.3"/>
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" Sprite="MPLobby\Generic\copy_icon" ColorFactor="0.8"/>
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" Sprite="MPLobby\Generic\copy_icon" ColorFactor="0.5"/>
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>
  
  <Brush Name="PartyAI.Menu.PasteButton" TransitionDuration="0.2">
    <Layers>
      <BrushLayer Name="Default" Sprite="SPPerks\CuriousSmelter" Color="#FEC157FF"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" Sprite="SPPerks\CuriousSmelter" ColorFactor="1"/>
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" Sprite="SPPerks\CuriousSmelter" ColorFactor="1.3"/>
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" Sprite="SPPerks\CuriousSmelter" ColorFactor="0.8"/>
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" Sprite="SPPerks\CuriousSmelter" ColorFactor="0.5"/>
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>
</Brushes>
